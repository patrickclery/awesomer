# /etc/systemd/system/awesomer-postgres.service
[Unit]
Description=awesomer-postgres (awesomer_platform backing DB)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
# Data lives on the NVMe (/var/lib/docker-data, btrfs subvol @docker-data).
# The sentinel check keeps us from binding an empty dir if the subvolume is
# somehow not mounted.
RequiresMountsFor=/var/lib/docker-data

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/awesomer

# PG 18 layout: PGDATA is /var/lib/postgresql/18/docker inside the container.
ExecStartPre=/usr/bin/test -s /var/lib/docker-data/awesomer/data/18/docker/PG_VERSION
ExecStartPre=/usr/bin/test -d /var/lib/docker-data/awesomer/data/18/docker/base

ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop -t 60

TimeoutStartSec=300
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
