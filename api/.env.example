# Database
DATABASE_URL=postgresql://awesomer:awesomer@localhost:5433/awesomer_platform

# GitHub
GITHUB_API_KEY=ghp_your_token_here

# Admin sync API
ADMIN_API_KEY=your_admin_api_key_here

# GitHub Pages base path for static site (default: /awesomer)
BASE_PATH=/awesomer

# Umami analytics for the static site (read by web/src/app/layout.tsx at build time).
# rebuildStaticSite() passes the API process env through to `npm run build`, so set these
# here for the nightly rebuild. The tag is omitted when either is unset (a warning is logged).
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://umami.example.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
